# Optional read-only RPC override. Deployment is restricted to chain 10143.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Leave blank to deploy a clearly labelled TestChog NFT first.
# Only set an ERC-721 address that actually exists on the CURRENT testnet.
CHOG_COLLECTION_ADDRESS=

# Configure locally only when ready to broadcast using a disposable testnet wallet.
# Never paste this key into chat or commit .env.
DEPLOYER_PRIVATE_KEY=

# --- Monad mainnet (npm.cmd run deploy:mainnet) ---
# Optional HTTPS RPC override for mainnet reads and deployment.
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
# Public address of the mainnet deployer; enough for --preflight without a key.
MAINNET_DEPLOYER_ADDRESS=
# A fresh, separately secured mainnet wallet. Must not be the testnet DEPLOYER_PRIVATE_KEY wallet.
# Only needed for --broadcast. Never paste it into chat or commit .env.
MAINNET_DEPLOYER_PRIVATE_KEY=
# Optional: publish source on MonadScan as well as Sourcify (npm.cmd run verify:mainnet).
MONADSCAN_API_KEY=
