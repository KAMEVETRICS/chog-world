{
  "compilerOptions": {
    "target": "ES2023",
    // Bundler resolution so the server can import Chog City's simulation from ../city/src as is
    // (extensionless imports); tsx runs both from source.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "test"]
}
