# Chog World Order production settings. On the server: cp production.env.example .env, fill it in, chmod 600 .env.
# Never commit, upload elsewhere or paste this file anywhere: it holds the database password and API key.

# Your domain, with an A record pointing at this server. No https:// and no path. Sign-in is tied to it.
CULT_DOMAIN=world.example.com

# HTTPS in front of the app. "caddy" starts our own Caddy on ports 80/443. If this server already runs a web server
# on 80/443 (Caddy, nginx), leave COMPOSE_PROFILES empty, set CULT_TRUSTED_PROXY=172.28.0.1 and point that web
# server at 127.0.0.1:APP_HOST_PORT (README: "A server that already has a web server").
COMPOSE_PROFILES=caddy
# CULT_TRUSTED_PROXY=172.28.0.1
# APP_HOST_PORT=8790

# Database password. Make one on the server with: openssl rand -hex 24  (letters and digits only: it goes into a URL)
POSTGRES_PASSWORD=

# Monad mainnet RPC over HTTPS; logs only ever show its host. From cloud servers the shared rpc.monad.xyz often
# answers 429 (too many requests). In a test from AWS on 2026-10-21 only rpc2.monad.xyz had everything the app needs
# without throttling: the finalized block, contract reads pinned to a block hash, the adapter's deployment receipt and
# logs back to its activation block (rpc3 had no old receipts; rpc1 and rpc-mainnet.monadinfra.com no pinned reads).
# A provider URL with your own key is faster still.
MONAD_MAINNET_RPC_URL=https://rpc2.monad.xyz

# Cult rhythm, fixed by the first start (the database keeps it):
#   demo       = a 6-minute cycle, so visitors and judges see debates, votes and rulers change
#   production = one cycle a day
CULT_TIMING=demo

# Optional: a roster of Chogs to admit at start (JSON inside the image). Empty starts with an empty village;
# holders bring their own awakened Chogs in from /city/.
CULT_ROSTER_PATH=

# Chog Soul AI (optional). Use a separate OpenRouter key made for this server, with a spending limit.
# Empty keeps AI off: chat says so, and Cult debates and votes stay rule-based.
OPENROUTER_API_KEY=
SOUL_MODEL=anthropic/claude-haiku-5.5

# $CHOG top-ups (optional, set both): the treasury holders send $CHOG to, and the first block credited.
SOUL_TREASURY=0x04D32C3243c1a58D15E1bC7B036629eDB6B86Cc5
SOUL_START_BLOCK=115000089
