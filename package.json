{
  "name": "chog-awakening",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "test": "npm run compile && node --test --test-concurrency=1 test/*.test.mjs",
    "demo": "npm run compile && node scripts/demo.mjs",
    "deploy:plan": "npm run compile && node scripts/deploy.mjs",
    "deploy:testnet": "npm run compile && node scripts/deploy.mjs --broadcast",
    "check:monad": "node scripts/check-monad.mjs",
    "test:fork": "node --test --test-concurrency=1 test/fork/*.test.mjs",
    "deploy:mainnet": "npm run compile && node scripts/deploy-mainnet.mjs",
    "verify:mainnet": "node scripts/verify-source.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "ethers": "6.17.0",
    "hardhat": "3.20.0",
    "solc": "0.8.24"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
